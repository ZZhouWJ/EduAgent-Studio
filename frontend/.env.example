# 环境变量（所有命名必须以 VITE_ 开头）
# 注意：前端使用 Vite，默认只加载 .env 文件（所有环境共享）
# 如需按环境覆盖，请修改对应 .env.development / .env.production / .env.staging

## 项目标题
VITE_APP_TITLE = 智研协作 AI 项目质量审计系统

## 后端接口地址
# 本项目后端 FastAPI 运行地址
# axios.ts 读取 import.meta.env.VITE_BASE_URL
VITE_BASE_URL = http://127.0.0.1:8000

## 路由模式：hash（默认）或 html5
VITE_ROUTER_HISTORY = hash

## 静态资源公共路径（一般 / 或 ./ 都可以）
VITE_PUBLIC_PATH = /

# ==============================================
# 生产环境配置（.env.production）
# VITE_BASE_URL = <替换为实际生产环境后端地址>
#
# 预发布环境配置（.env.staging）
# VITE_BASE_URL = <替换为实际预发布环境后端地址>
# ==============================================
