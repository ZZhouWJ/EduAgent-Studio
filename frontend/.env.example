# Frontend Environment Variables (all must start with VITE_)

# Static assets public path
VITE_PUBLIC_PATH=/

# API proxy target for development
# In dev mode, vite proxies /api requests to this target
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Fallback if VITE_API_PROXY_TARGET is not set
VITE_API_BASE_URL=http://127.0.0.1:8000

