# EduAgent Studio Docker Compose configuration
# Copy this file to .env and replace every change_me value before startup.

APP_ENV=development
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
BACKEND_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379

# MySQL
DB_NAME=ai_collab_audit_system
DB_PASSWORD=change_me_mysql_password

# Security: generate independent values with `openssl rand -hex 32`.
JWT_SECRET_KEY=change_me_with_64_random_hex_characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
API_KEY_SECRET=change_me_with_64_random_hex_characters
CORS_ORIGINS=http://localhost:5173

# LLM: mock works without an external API key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# iFlytek integrations are optional.
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_DOC_ID=
