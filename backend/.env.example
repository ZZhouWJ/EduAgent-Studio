# ============================================================
# AI-Collab-Audit-System - Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
# ============================================================

# --- 应用信息 ---
APP_NAME=AI-Collab-Audit-System
APP_ENV=development
API_PREFIX=/api

# --- 服务器配置（启动端口，与 run.py 的 --host/--port 一致）---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- 数据库配置 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_NAME=ai_collab_audit_system
DB_CHARSET=utf8mb4

# --- JWT 配置 ---
JWT_SECRET_KEY=<YOUR_JWT_SECRET_KEY>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- API Key 加密密钥（32 字节十六进制或 Base64）---
API_KEY_SECRET=<YOUR_32_BYTE_SECRET_BASE64_OR_HEX>
