# EduAgent Studio backend configuration
APP_NAME=EduAgent Studio
APP_ENV=development
API_PREFIX=/api
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me_mysql_password
DB_NAME=ai_collab_audit_system

# Development seed only. Use a unique value with at least 12 characters.
DEMO_PASSWORD=

# Security: generate independent values with `openssl rand -hex 32`.
JWT_SECRET_KEY=change_me_with_64_random_hex_characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
API_KEY_SECRET=change_me_with_64_random_hex_characters
CORS_ORIGINS=http://localhost:5173

# Provider: mock / openai_compatible / iflytek
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_DOC_ID=

REDIS_URL=redis://127.0.0.1:6379/0
APP_DATA_DIR=data
