# EduAgent Studio 后端配置示例

APP_NAME=EduAgent Studio
APP_ENV=development
API_PREFIX=/api

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# MySQL（当前）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_collab_audit_system
DB_CHARSET=utf8mb4

# PostgreSQL（Phase 2）
# DB_TYPE=postgresql
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=EduAgent2026
# POSTGRES_DB=eduagent_studio

JWT_SECRET_KEY=change_me_to_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

API_KEY_SECRET=change_me_to_32_byte_hex_key

# LLM
# Provider: mock (测试) / openai_compatible (OpenAI / DeepSeek / Qwen 等)
LLM_PROVIDER=openai_compatible
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# DeepSeek 示例（与 OpenAI API 格式兼容）:
#   LLM_PROVIDER=openai_compatible
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 阿里云 Qwen 示例:
#   LLM_PROVIDER=openai_compatible
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-max
# OpenAI 示例:
#   LLM_PROVIDER=openai_compatible
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o
