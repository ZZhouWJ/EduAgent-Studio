# EduAgent Studio 后端配置示例

APP_NAME=EduAgent Studio
APP_ENV=development
API_PREFIX=/api

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# MySQL（当前）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_collab_audit_system
DB_CHARSET=utf8mb4

# PostgreSQL（Phase 2）
# DB_TYPE=postgresql
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
