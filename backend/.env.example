JWT_SECRET_KEY=change_me_to_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

API_KEY_SECRET=change_me_to_32_byte_hex_key

# LLM
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
